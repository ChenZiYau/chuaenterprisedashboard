# Server-only secret for /api/keepalive. Set a random value in Vercel, then
# redeploy. Call with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Existing GitHub Actions scheduler queries Supabase directly. Configure
# these two repository Actions secrets; CRON_SECRET is not used by that job.
# The server also requires these (NEXT_PUBLIC_SUPABASE_URL is a URL fallback).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard session signing (at least 32 random characters, server-only).
SESSION_SECRET=

# Optional Image Vault integration. The public URL is also used by share links.
NEXT_PUBLIC_VAULT_URL=
VAULT_API_KEY=
